{
  "buildCommand": "cd aljazari-academy && npm run build",
  "installCommand": "npm install --legacy-peer-deps",
  "outputDirectory": "aljazari-academy/dist",
  "rewrites": [
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, s-maxage=3600"
        }
      ]
    }
  ]
}
